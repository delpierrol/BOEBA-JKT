# Domain for Caddy automatic HTTPS (use :80 for IP-only / local testing)
DOMAIN=booking.boeba.id
CORS_ORIGIN=https://booking.boeba.id

# PostgreSQL
POSTGRES_USER=boeba
POSTGRES_PASSWORD=change_this_strong_postgres_password
POSTGRES_DB=boeba
    
# Auth JWT Secret (generate with: openssl rand -hex 32)
JWT_SECRET=change_this_to_a_long_random_secret_string

# Initial Admin Account (used by `npm run seed`)
ADMIN_EMAIL=admin@boeba.id
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Boeba Admin

# Google reCAPTCHA v2 Secret Key
RECAPTCHA_SECRET_KEY=

# WPPConnect WhatsApp API
WPPCONNECT_API_URL=
WPPCONNECT_SESSION_NAME=
WPPCONNECT_SECRET_KEY=

# Email Sender via SMTP (pilih salah satu: Resend atau Brevo)
# --- Contoh Resend ---
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASS=re_xxxxxxxxx
# SMTP_FROM=no-reply@boeba.id
#
# --- Contoh Brevo ---
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@boeba.id
