{
  "name": "WaitingList",
  "type": "object",
  "properties": {
    "customer_name": {
      "type": "string",
      "description": "Name of the customer"
    },
    "whatsapp_number": {
      "type": "string",
      "description": "WhatsApp number for contact"
    },
    "booking_date": {
      "type": "string",
      "format": "date",
      "description": "Desired booking date"
    },
    "time_slot": {
      "type": "string",
      "description": "Desired time slot"
    },
    "party_size": {
      "type": "integer",
      "description": "Number of guests"
    },
    "status": {
      "type": "string",
      "enum": [
        "waiting",
        "contacted",
        "booked",
        "cancelled"
      ],
      "default": "waiting",
      "description": "Status of waiting list entry"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes"
    }
  },
  "required": [
    "customer_name",
    "whatsapp_number",
    "booking_date",
    "time_slot",
    "party_size"
  ]
}